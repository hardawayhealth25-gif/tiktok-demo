# Hardaway Labs Social - TikTok Demo Configuration
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-change-this-in-production

# TikTok OAuth Configuration
# NOTE: For SANDBOX environment (demo), use the sandbox client key
# For PRODUCTION environment, use the production client key
# These should be obtained from TikTok Developer Console: https://developer.tiktok.com/

# Sandbox/Demo Credentials
TIKTOK_CLIENT_KEY=your_sandbox_client_key_here
TIKTOK_CLIENT_SECRET=your_sandbox_client_secret_here

# Production Credentials (when ready to go live)
# TIKTOK_CLIENT_KEY=your_production_client_key_here
# TIKTOK_CLIENT_SECRET=your_production_client_secret_here

# Redirect URI - must match what you registered in TikTok Developer Console
# For local development:
TIKTOK_REDIRECT_URI=http://localhost:5000/auth/tiktok/callback

# For production (uncomment and update):
# TIKTOK_REDIRECT_URI=https://www.healthyoneapp.com/auth/tiktok/callback

# Optional: Logging
# LOG_LEVEL=DEBUG
# LOG_FILE=tiktok_demo.log
