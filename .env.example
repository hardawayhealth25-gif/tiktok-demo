# TikTok OAuth 2.0 Configuration
TIKTOK_CLIENT_KEY=your_client_key_here
TIKTOK_CLIENT_SECRET=your_client_secret_here

# Redirect URI - must match the one registered in TikTok Developer Console
# For local development:
REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

# For Render deployment:
# REDIRECT_URI=https://your-render-app.onrender.com/auth/tiktok/callback

# Server Configuration
PORT=3000
NODE_ENV=production

# Session Secret - change this to a random string in production
SESSION_SECRET=your-secret-key-change-this-in-production
